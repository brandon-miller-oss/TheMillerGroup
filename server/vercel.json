{
  "functions": {
    "api/idx.js": {
      "maxDuration": 10
    },
    "api/ai.js": {
      "maxDuration": 60
    },
    "api/email.js": {
      "maxDuration": 15
    },
    "api/followups-cron.js": {
      "maxDuration": 60
    },
    "api/page.js": {
      "maxDuration": 10
    },
    "api/sitemap.js": {
      "maxDuration": 10
    },
    "api/notify.js": {
      "maxDuration": 15
    },
    "api/client-reminders.js": {
      "maxDuration": 60
    },
    "api/newsletter.js": {
      "maxDuration": 60
    },
    "api/unsubscribe.js": {
      "maxDuration": 10
    },
    "api/news.js": {
      "maxDuration": 120
    },
    "api/daily.js": {
      "maxDuration": 300
    },
    "api/hazards.js": {
      "maxDuration": 10
    },
    "api/guide.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/daily",
      "schedule": "0 15 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/a/:agent",
      "destination": "/api/page?a=:agent"
    },
    {
      "source": "/a/:agent/:page",
      "destination": "/api/page?a=:agent&p=:page"
    },
    {
      "source": "/sitemap-agents.xml",
      "destination": "/api/sitemap"
    }
  ]
}
