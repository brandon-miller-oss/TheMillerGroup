{
  "functions": {
    "api/idx.js": {
      "maxDuration": 10
    },
    "api/ai.js": {
      "maxDuration": 60
    },
    "api/email.js": {
      "maxDuration": 15
    },
    "api/followups-cron.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/followups-cron",
      "schedule": "0 15 * * *"
    }
  ]
}