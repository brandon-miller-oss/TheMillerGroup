# REcolorado data through Bridge Interactive
BRIDGE_DATASET_ID=
BRIDGE_SERVER_TOKEN=
BRIDGE_BASE_URL=https://api.bridgedataoutput.com/api/v2/OData
BRIDGE_RESOURCE=Property

# Your website addresses, comma-separated (GitHub Pages and your custom domain)
ALLOWED_ORIGINS=https://brandon-miller-oss.github.io,https://millerpropertygrp.com,https://www.millerpropertygrp.com

# Supabase (Project Settings > API). The service role key stays on the server only.
SUPABASE_URL=
# Project Settings > API Keys: the secret key (sb_secret_…). Never put it in the website. A legacy service_role key also works as SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
# The public anon key: agent websites and landing pages (/a/<agent>/<page>) read published pages with it
# The publishable key (sb_publishable_…), the same one as SUPABASE_ANON_KEY in assets/config.js. A legacy anon key also works as SUPABASE_ANON_KEY.
SUPABASE_PUBLISHABLE_KEY=
# Shown on agent pages
SITE_URL=https://brandon-miller-oss.github.io/TheMillerGroup
BUSINESS_NAME=The Miller Group
LICENSE_TEXT=

# Claude API for the assistant, captions, and CMA summaries
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Listing costs and hazards (optional)
# BRIDGE_COST_FIELDS=TaxAnnualAmount,TaxYear,AssociationFee,AssociationFeeFrequency,AssociationFee2,AssociationFee2Frequency   # or "none"
# FEMA_NFHL_URL=https://hazards.fema.gov/arcgis/rest/services/public/NFHL/MapServer/28/query

# Follow-up emails (Resend, resend.com). EMAIL_FROM must be on a domain you verify in Resend.
RESEND_API_KEY=
EMAIL_FROM=updates@themillergroup.com
EMAIL_FOOTER=The Miller Group, LLC · [mailing address] · Denver, CO
# Daily automatic follow-ups: any long random string. Vercel sends it to the job.
CRON_SECRET=
TIME_ZONE=America/Denver

# Client updates by text (optional). Twilio requires US A2P 10DLC registration before texts are delivered.
# Use either a phone number or a Messaging Service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Newsletters
# Public address of this server (unsubscribe links point here), e.g. https://miller-tools.vercel.app
PUBLIC_API_URL=
# Long random string used to sign unsubscribe links
UNSUBSCRIBE_SECRET=
# Brokerage mailing address shown in every newsletter (CAN-SPAM requires a physical address)
BUSINESS_ADDRESS=
NEWSLETTER_MAX=2000
