# REcolorado data through Bridge Interactive
BRIDGE_DATASET_ID=
BRIDGE_SERVER_TOKEN=
BRIDGE_BASE_URL=https://api.bridgedataoutput.com/api/v2/OData
BRIDGE_RESOURCE=Property

# Your website addresses, comma-separated (GitHub Pages and your custom domain)
ALLOWED_ORIGINS=https://brandon-miller-oss.github.io,https://themillergroup.com

# Supabase (Project Settings > API). The service role key stays on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API for the assistant, captions, and CMA summaries
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
